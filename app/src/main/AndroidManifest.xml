<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET tem escopo estrito e revisa a regra das fases 1 a 6: só serve para a
      auto-atualização — checar versão, baixar o APK e buscar a config remota, tudo em
      github.com. Nenhum dado de bateria sai do aparelho, e não há analytics, crash reporting
      nem telemetria de espécie alguma. Ver network_security_config.xml e o README.

      BATTERY_STATS é declarada aqui, mas isso NÃO a concede: numa instalação normal ela
      permanece signature|privileged e o sistema a nega. Declarar é só o pré-requisito para que
      `adb shell pm grant` possa concedê-la — o PackageManager recusa conceder uma permissão que
      o app não pediu.

      O protectionLevel real dela no AOSP é `signature|privileged|development`, e `development`
      significa concedível por shell. As fases anteriores partiam de que era apenas
      `signature|privileged`, o que estava factualmente errado.

      Concedida, ela destrava SystemHealthManager.takeUidSnapshot — SDK público, sem reflection —
      e o consumo por app deixa de ser correlação e passa a ser contador medido de wakelock, GPS,
      jobs e estado de processo. Sem ela o app funciona igual a antes.

      Isto continua não dando mAh medido por app: esse número não existe em nenhum nível de
      privilégio, nem com root. O framework mede tempo e multiplica por constantes declaradas
      pelo fabricante em power_profile.xml.
    -->
    <uses-permission
        android:name="android.permission.BATTERY_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Instalar o APK baixado. Ver a cascata de instalação no README. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Amostragem contínua sobrevive em foreground service; o tipo specialUse é o único honesto
         para "monitorar a própria bateria". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- A notificação persistente do foreground service (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Religar a amostragem depois do boot, atrás de um toggle nas configurações. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Pedir isenção da otimização de bateria; sem ela o app morre justamente enquanto mede. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Watchdog que ressuscita o serviço quando o sistema o derruba.
      USE_EXACT_ALARM (API 33+) é concedida automaticamente; SCHEDULE_EXACT_ALARM (API 31–32) é
      concedida por padrão mas revogável, e é pedida na tela de Saúde da coleta quando falta.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Timeline de app em primeiro plano. Concedida na tela de Configurações, não em runtime. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".BatteryStatsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.BatteryStats">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BatteryStats">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.sampling.SamplingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Amostragem periódica do estado da bateria do próprio aparelho para análise local de consumo." />
        </service>

        <receiver
            android:name=".data.receiver.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.receiver.SamplingWatchdogReceiver"
            android:exported="false" />

        <!-- Desfecho das sessões do PackageInstaller. -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.ederfmatos.batterystats.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Entrega o APK baixado ao instalador do sistema como content://, nunca file://. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
