    <!-- Permissões -->
    <string name="permission_notifications_rationale">O Android exige uma notificação visível enquanto o app mede em segundo plano. Sem a permissão de notificação o serviço não sobe.</string>
    <string name="permission_notifications_action">Permitir notificação</string>
    <string name="permission_battery_title">Isenção de otimização de bateria</string>
    <string name="permission_battery_rationale">Sem essa isenção o Android mata o app justamente quando ele está medindo: nas horas de tela desligada, que são o dado mais útil daqui. A isenção não faz o app consumir mais — ele continua acordando só no intervalo configurado.</string>
    <string name="permission_battery_action">Pedir isenção</string>
    <string name="permission_battery_granted">Isenção concedida</string>
    <string name="permission_usage_title">Acesso ao uso de apps</string>
    <string name="permission_usage_rationale">Serve para saber qual app estava na frente em cada janela de tempo. É o que permite montar o ranking. Sem isso o app continua medindo a bateria, só não sabe a quem atribuir o consumo.</string>
    <string name="permission_usage_action">Abrir configurações de uso</string>
    <string name="permission_usage_granted">Acesso concedido</string>

